# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI / OCR screenshot analysis (Gemini API — Google AI Studio key)
AI_PROVIDER_API_KEY=your_gemini_api_key
AI_PROVIDER_MODEL=gemini-3.5-flash-lite
# Routes Gemini calls through your own /api/proxy/gemini edge route (pinned to
# iad1) instead of calling Google directly, so Vercel's hkg1 geo-block doesn't
# apply. Update the domain if it ever changes.
AI_PROVIDER_BASE_URL=https://your-vercel-deployment.vercel.app/api/proxy/gemini

# Public site name (used in metadata/branding)
NEXT_PUBLIC_SITE_NAME="2K Veterans League"
